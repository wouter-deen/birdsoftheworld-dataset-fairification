@prefix : <http://fairdatapoint.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .

@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

:GeneralinformationGroup a sh:PropertyGroup ; rdfs:label "General information" ; sh:order 0 .
:ProvenanceGroup a sh:PropertyGroup ; rdfs:label "Provenance and reuse" ; sh:order 1 .
:CoverageGroup a sh:PropertyGroup ; rdfs:label "Coverage" ; sh:order 2 .
:AccessGroup a sh:PropertyGroup ; rdfs:label "Access and distributions" ; sh:order 3 .
:ContactGroup a sh:PropertyGroup ; rdfs:label "Contact" ; sh:order 4 .

:BirdSightingsMetadataShape a sh:NodeShape ;
    rdfs:label "Bird sightings dataset metadata profile" ;
    dct:description "Dataset-specific fields extending the shared FDP ResourceShape. Configure the parent through FDP's Extends setting; load resource-shape.ttl alongside this file for local validation." ;
    sh:targetClass dcat:Dataset ;
    sh:node :ResourceShape ;
    sh:property [
        sh:path dct:issued ; sh:name "Issued" ;
        sh:description "Date on which the dataset was issued (not the observation period)" ;
        sh:datatype xsd:dateTime ; sh:maxCount 1 ;
        sh:order 2 ; dash:editor dash:DateTimePickerEditor ; sh:group :GeneralinformationGroup
    ] ;
    sh:property [
        sh:path dct:modified ; sh:name "Modified" ;
        sh:description "Last modification date of the published dataset" ;
        sh:datatype xsd:dateTime ; sh:maxCount 1 ;
        sh:order 3 ; dash:editor dash:DateTimePickerEditor ; sh:group :GeneralinformationGroup
    ] ;
    sh:property [
        sh:path dcat:keyword ; sh:name "Keyword" ;
        sh:datatype xsd:string ;
        sh:order 4 ; dash:editor dash:TextFieldEditor ; sh:group :GeneralinformationGroup
    ] ;

    sh:property [
        sh:path dct:creator ; sh:name "Creator" ;
        sh:description "Person or organization that created this dataset version" ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:node :AgentShape ;
        sh:order 1 ; dash:editor dash:BlankNodeEditor ; sh:group :ProvenanceGroup
    ] ;
    sh:property [
        sh:path dct:source ; sh:name "Source dataset" ;
        sh:description "Original dataset used to create this version, if applicable" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:order 2 ; dash:editor dash:URIEditor ; sh:group :ProvenanceGroup
    ] ;

    sh:property [
        sh:path dct:accessRights ; sh:name "Access rights" ;
        sh:description "Access category (not a substitute for a reuse licence)" ;
        sh:datatype xsd:string ; sh:in ("public" "restricted" "private") ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:order 0 ; dash:editor dash:EnumSelectEditor ; sh:group :AccessGroup
    ] ;
    sh:property [
        sh:path dcat:landingPage ; sh:name "Landing page" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:order 1 ; dash:editor dash:URIEditor ; sh:group :AccessGroup
    ] ;
    sh:property [
        sh:path dcat:distribution ; sh:name "Distribution" ;
        sh:description "Links to separately described distribution records, managed as child resources in FDP" ;
        sh:nodeKind sh:IRI ;
        sh:order 2 ; sh:group :AccessGroup
    ] ;
    sh:property [
        sh:path dct:spatial ; sh:name "Spatial coverage" ;
        sh:description "Geographic coverage of the observations, if known" ;
        sh:nodeKind sh:IRI ;
        sh:order 0 ; dash:editor dash:URIEditor ; sh:group :CoverageGroup
    ] ;
    sh:property [
        sh:path dct:temporal ; sh:name "Temporal coverage" ;
        sh:description "Time period covered by the sightings (not the publication date)" ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:node :PeriodShape ;
        sh:maxCount 1 ; sh:order 1 ;
        dash:editor dash:BlankNodeEditor ; sh:group :CoverageGroup
    ] ;
    sh:property [
        sh:path dcat:contactPoint ; sh:name "Contact point" ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:node :ContactShape ;
        sh:maxCount 1 ; sh:order 0 ;
        dash:editor dash:BlankNodeEditor ; sh:group :ContactGroup
    ] .


:PeriodShape a sh:NodeShape ;
    sh:property [
        sh:path dcat:startDate ; sh:name "Coverage start" ;
        sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:order 0 ;
        dash:editor dash:DateTimePickerEditor
    ] ;
    sh:property [
        sh:path dcat:endDate ; sh:name "Coverage end" ;
        sh:datatype xsd:dateTime ; sh:maxCount 1 ; sh:order 1 ;
        dash:editor dash:DateTimePickerEditor
    ] .

:ContactShape a sh:NodeShape ;
    sh:property [
        sh:path vcard:fn ; sh:name "Full name" ;
        sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:order 0 ; dash:editor dash:TextFieldEditor
    ] ;
    sh:property [
        sh:path vcard:hasEmail ; sh:name "Email" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:order 1 ; dash:editor dash:URIEditor
    ] .
