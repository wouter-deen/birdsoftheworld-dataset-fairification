<https://w3id.org/FAIR-course-UT/2025-2026/group11/metadata/dataset> a dcat:Dataset,
        dcat:Resource ;
    rdfs:label "Birdsoftheworld-fairified" ;
    dct:accessRights "public" ;
    dct:conformsTo <https://w3id.org/FAIR-course-UT/2025-2026/group11/schema/dataset> ;
    dct:creator [ a foaf:Agent ;
            foaf:name "Quirijn Hoenink" ],
        [ a foaf:Agent ;
            foaf:name "Wouter Deen" ] ;
    dct:description "FAIRified bird sighting and trait observations derived from the Birdsoftheworld-unprocessed dataset on Kaggle. The workflow includes repair of the source CSV, feature extraction from bird descriptions, normalization of trait values, semantic annotation and RDF transformation." ;
