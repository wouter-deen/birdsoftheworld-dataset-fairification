@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

<https://w3id.org/FAIR-course-UT/2026/group11/dataset/bird-observations>
    a dcat:Dataset ;
    dct:title "Birdsoftheworld-fairified" ;
    dct:description "FAIRified bird sighting and trait observations derived from the Birdsoftheworld-unprocessed dataset on Kaggle. The workflow includes repair of the source CSV, feature extraction from bird descriptions, normalization of trait values, semantic annotation and RDF transformation." ;
    dct:issued "2026-10-30"^^xsd:date ;
    dcat:keyword "bird sightings", "bird traits", "biodiversity", "phenotypes", "FAIR data" ;
    dct:publisher <https://ror.org/006hf6230> ;
    dct:creator [
        a foaf:Person, foaf:Agent ;
        foaf:name "Quirijn Hoenink"
    ], [
        a foaf:Person, foaf:Agent ;
        foaf:name "Wouter Deen"
    ] ;
    dct:source <https://www.kaggle.com/datasets/anoopjohny/birdsoftheworld-unprocessed> ;
    dct:license <https://opendatacommons.org/licenses/odbl/1-0> ;
    dct:accessRights "public" ;
    dct:spatial <https://sws.geonames.org/6295630/> ;
    dcat:landingPage <https://github.com/wouter-deen/birdsoftheworld-dataset-fairification> ;
    dcat:distribution [
        a dcat:Distribution ;
        dct:title "FAIRified bird observations (RDF/Turtle)" ;
        dcat:accessURL <https://w3id.org/FAIR-course-UT/2026/group11/dataset/bird-observations/observations> ;
        dcat:downloadURL <https://w3id.org/FAIR-course-UT/2026/group11/dataset/bird-observations/observations.ttl> ;
        dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle>
    ], [
        a dcat:Distribution ;
        dct:title "Processed bird observations (CSV)" ;
        dcat:accessURL <https://w3id.org/FAIR-course-UT/2026/group11/dataset/bird-observations/observations> ;
        dcat:downloadURL <https://w3id.org/FAIR-course-UT/2026/group11/dataset/bird-observations/observations.csv> ;
        dcat:mediaType <https://www.iana.org/assignments/media-types/text/csv>
    ], [
        a dcat:Distribution ;
        dct:title "FAIRified bird trait observations (RDF/Turtle)" ;
        dcat:accessURL <https://w3id.org/FAIR-course-UT/2026/group11/dataset/bird-observations/traits> ;
        dcat:downloadURL <https://w3id.org/FAIR-course-UT/2026/group11/dataset/bird-observations/traits.ttl> ;
        dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle>
    ], [
        a dcat:Distribution ;
        dct:title "Processed bird trait observations (CSV)" ;
        dcat:accessURL <https://w3id.org/FAIR-course-UT/2026/group11/dataset/bird-observations/traits> ;
        dcat:downloadURL <https://w3id.org/FAIR-course-UT/2026/group11/dataset/bird-observations/traits.csv> ;
        dcat:mediaType <https://www.iana.org/assignments/media-types/text/csv>
    ] ;
    dcat:contactPoint [
        a vcard:Kind ;
        vcard:fn "Wouter Deen" ;
        vcard:hasEmail <mailto:s.w.deen@student.utwente.nl>
    ] .

<https://ror.org/006hf6230>
    a foaf:Organization, foaf:Agent ;
    foaf:name "University of Twente" .
