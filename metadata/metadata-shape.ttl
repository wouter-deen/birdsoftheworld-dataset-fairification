@prefix : <http://fairdatapoint.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

:GeneralinformationGroup a sh:PropertyGroup ; rdfs:label "General information" ; sh:order 0 .
:ProvenanceGroup a sh:PropertyGroup ; rdfs:label "Provenance and reuse" ; sh:order 1 .
:CoverageGroup a sh:PropertyGroup ; rdfs:label "Coverage" ; sh:order 2 .
:AccessGroup a sh:PropertyGroup ; rdfs:label "Access and distributions" ; sh:order 3 .
:ContactGroup a sh:PropertyGroup ; rdfs:label "Contact" ; sh:order 4 .

:BirdSightingsMetadataShape a sh:NodeShape ;
    rdfs:label "Bird sightings dataset metadata profile" ;
    dct:description "A reusable DCAT metadata profile for datasets of bird sightings, including derived/FAIRified versions." ;
    sh:targetClass dcat:Dataset ;
    sh:property [
        sh:path dct:title ; sh:name "Title" ;
        sh:description "Human-readable dataset title" ;
        sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:order 0 ; dash:editor dash:TextFieldEditor ; sh:group :GeneralinformationGroup
    ] ;
    sh:property [
        sh:path dct:description ; sh:name "Description" ;
        sh:description "What the dataset contains and how it was prepared" ;
        sh:datatype xsd:string ; sh:minCount 1 ;
        sh:order 1 ; dash:editor dash:TextAreaEditor ; sh:group :GeneralinformationGroup
    ] ;
    sh:property [
        sh:path dct:issued ; sh:name "Issued" ;
        sh:description "Date on which the dataset was issued (not the observation period)" ;
        sh:datatype xsd:date ; sh:maxCount 1 ;
        sh:order 2 ; dash:editor dash:DatePickerEditor ; sh:group :GeneralinformationGroup
    ] ;
    sh:property [
        sh:path dct:modified ; sh:name "Modified" ;
        sh:description "Last modification date of the published dataset" ;
        sh:datatype xsd:date ; sh:maxCount 1 ;
        sh:order 3 ; dash:editor dash:DatePickerEditor ; sh:group :GeneralinformationGroup
    ] ;
    sh:property [
        sh:path dcat:keyword ; sh:name "Keyword" ;
        sh:datatype xsd:string ;
        sh:order 4 ; dash:editor dash:TextFieldEditor ; sh:group :GeneralinformationGroup
    ] ;
    sh:property [
        sh:path dct:publisher ; sh:name "Publisher" ;
        sh:description "Agent responsible for publishing the dataset" ;
        sh:nodeKind sh:IRI ; sh:class foaf:Agent ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:order 0 ; dash:editor dash:AutoCompleteEditor ; sh:group :ProvenanceGroup
    ] ;
    sh:property [
        sh:path dct:creator ; sh:name "Creator" ;
        sh:description "Person or organization that created this dataset version" ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:class foaf:Agent ;
        sh:order 1 ; sh:group :ProvenanceGroup
    ] ;
    sh:property [
        sh:path dct:source ; sh:name "Source dataset" ;
        sh:description "Original dataset used to create this version, if applicable" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:order 2 ; dash:editor dash:URIEditor ; sh:group :ProvenanceGroup
    ] ;
    sh:property [
        sh:path dct:license ; sh:name "Licence" ;
        sh:description "URI of the applicable reuse licence (verify against the source licence)" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:order 4 ; dash:editor dash:URIEditor ; sh:group :ProvenanceGroup
    ] ;
    sh:property [
        sh:path dct:accessRights ; sh:name "Access rights" ;
        sh:description "Access category (not a substitute for a reuse licence)" ;
        sh:datatype xsd:string ; sh:in ("public" "restricted" "private") ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:order 0 ; dash:editor dash:EnumSelectEditor ; sh:group :AccessGroup
    ] ;
    sh:property [
        sh:path dcat:landingPage ; sh:name "Landing page" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:order 1 ; dash:editor dash:URIEditor ; sh:group :AccessGroup
    ] ;
    sh:property [
        sh:path dcat:distribution ; sh:name "Distribution" ;
        sh:description "Actual downloadable representation(s) of the dataset" ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:node :DistributionShape ;
        sh:order 2 ; dash:editor dash:DetailsEditor ; sh:group :AccessGroup
    ] ;
    sh:property [
        sh:path dct:spatial ; sh:name "Spatial coverage" ;
        sh:description "Geographic coverage of the observations, if known" ;
        sh:nodeKind sh:IRI ;
        sh:order 0 ; dash:editor dash:URIEditor ; sh:group :CoverageGroup
    ] ;
    sh:property [
        sh:path dct:temporal ; sh:name "Temporal coverage" ;
        sh:description "Time period covered by the sightings (not the publication date)" ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:node :PeriodShape ;
        sh:maxCount 1 ; sh:order 1 ;
        dash:editor dash:DetailsEditor ; sh:group :CoverageGroup
    ] ;
    sh:property [
        sh:path dcat:contactPoint ; sh:name "Contact point" ;
        sh:nodeKind sh:BlankNodeOrIRI ; sh:node :ContactShape ;
        sh:maxCount 1 ; sh:order 0 ;
        dash:editor dash:DetailsEditor ; sh:group :ContactGroup
    ] .

:DistributionShape a sh:NodeShape ;
    sh:property [
        sh:path dcat:downloadURL ; sh:name "Download URL" ;
        sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:order 0 ; dash:editor dash:URIEditor
    ] ;
    sh:property [
        sh:path dcat:mediaType ; sh:name "Media type" ;
        sh:description "IANA media type IRI, e.g., text/turtle" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:order 1 ; dash:editor dash:URIEditor
    ] ;
    sh:property [
        sh:path dcat:accessURL ; sh:name "Access URL" ;
        sh:description "Format-independent access URL supporting content negotiation" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:order 2 ; dash:editor dash:URIEditor
    ] .

:PeriodShape a sh:NodeShape ;
    sh:property [
        sh:path dcat:startDate ; sh:name "Coverage start" ;
        sh:datatype xsd:date ; sh:maxCount 1 ; sh:order 0 ;
        dash:editor dash:DatePickerEditor
    ] ;
    sh:property [
        sh:path dcat:endDate ; sh:name "Coverage end" ;
        sh:datatype xsd:date ; sh:maxCount 1 ; sh:order 1 ;
        dash:editor dash:DatePickerEditor
    ] .

:ContactShape a sh:NodeShape ;
    sh:property [
        sh:path vcard:fn ; sh:name "Full name" ;
        sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:order 0 ; dash:editor dash:TextFieldEditor
    ] ;
    sh:property [
        sh:path vcard:hasEmail ; sh:name "Email" ;
        sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:order 1 ; dash:editor dash:URIEditor
    ] .
